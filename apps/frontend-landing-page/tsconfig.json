{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node", "react", "react-dom", "@cloudflare/workers-types", "vite/client"],
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["*.config.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
