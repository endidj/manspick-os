// 랜딩·고객 테스트 앱만 연결하는 비공개 API와 전용 D1·R2를 설정합니다.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "manspick-public-api-test",
  "main": "public-test.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "class-validator": "../apps/server/src/runtime/unsupported.ts",
    "class-transformer": "../apps/server/src/runtime/unsupported.ts",
    "@nestjs/microservices": "../apps/server/src/runtime/unsupported.ts",
    "@nestjs/websockets/socket-module.js": "../apps/server/src/runtime/unsupported.ts",
    "@nestjs/microservices/microservices-module.js": "../apps/server/src/runtime/unsupported.ts",
  },
  "vars": {
    "LOCAL_DEMO": "false",
    "CUSTOMER_APP_ORIGIN": "https://manspick-customer-test.winningant8.workers.dev",
  },
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manspick-public-test-db",
      "database_id": "53e6d1ae-7880-4fdb-95d3-09f683fd7e97",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "manspick-public-test-media" }],
  "observability": { "enabled": false },
}
